# DeskFlow 环境变量示例
# ------------------------------------------------------------------
# 这个文件【可以提交】到 git，因为它只有键名和假值。
# 用法：复制一份改名为 .env，把假值换成真值。.env 已被 .gitignore 排除。
#     copy .env.example .env      （Windows）
#     cp .env.example .env        （mac/Linux）
# ------------------------------------------------------------------

# 运行环境：dev / prod。dev 会开 SQL 日志、允许 /docs
APP_ENV=dev

# 数据库连接串
# sqlite 写法：sqlite:///./deskflow.db   ← 三个斜杠，后面是相对路径
# mysql 写法：mysql+pymysql://用户:密码@主机:3306/库名
DATABASE_URL=sqlite:///./deskflow.db

# JWT 签名密钥（生产环境必须是随机长串，泄露=任何人都能伪造 token）
# 生成方法：python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-string

# token 有效期（分钟）。计划书要求 8 小时 = 480 分钟
TOKEN_EXPIRE_MINUTES=480

# LLM 配置（DeepSeek 兼容 OpenAI 协议）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
