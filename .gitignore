# DeskFlow · .gitignore
# ------------------------------------------------------------------
# 作用：告诉 git "这些文件不要纳入版本管理"
# 为什么必须写：node_modules、.venv 加起来几百 MB，提交上去仓库就废了；
#              .env 里有 API key，提交上去等于把钥匙挂在公网上。
# ------------------------------------------------------------------

# --- 虚拟环境（每个开发机自己建，不进仓库）---
.venv/
venv/
env/

# --- 密钥（最重要的一条）---
# .env 存真实 key；.env.example 只存"键名 + 假值"，用来告诉别人要配哪些
.env
.env.local

# --- Python 缓存 ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- 数据库文件（开发时随时可重建，不该进仓库）---
*.db
*.sqlite
*.sqlite3

# --- 编辑器 / 系统 ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- 日志 ---
*.log
logs/
